# ==========================================
# GYMFORGE (ACADEMIA RPG) — VARIÁVEIS DE AMBIENTE
# ==========================================

# ------------------------------------------
# FRONTEND CONFIGURATION (Vite / Netlify)
# ------------------------------------------
# Obtenha estas credenciais no Firebase Console (Configurações do Projeto > Seus Aplicativos > Web)
VITE_FIREBASE_API_KEY=sua_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# URL do Backend Python (Local ou PythonAnywhere)
# Local: http://localhost:8000
# Produção: https://seu-usuario.pythonanywhere.com
VITE_API_BASE_URL=http://localhost:8000

# ------------------------------------------
# BACKEND CONFIGURATION (FastAPI / PythonAnywhere)
# ------------------------------------------
# Ambiente: 'development' ou 'production'
ENVIRONMENT=development
PORT=8000

# Domínios permitidos no CORS (separados por vírgula)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://gymforge.netlify.app

# Google Gemini API Key (para o Assistente Mestre da Forja e MCP)
GEMINI_API_KEY=sua_chave_gemini_aqui

# Caminho para o arquivo de credenciais da conta de serviço do Firebase (Firestore Admin)
# Em desenvolvimento local, se não fornecido, o backend opera com fallback em memória/mock seguro
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
